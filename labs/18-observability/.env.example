# ============================================================
# 复制本文件为 .env 并填入你自己的值：
#   cp .env.example .env
# .env 已被 .gitignore 排除，绝不会提交到仓库
# ============================================================

# ---------- DeepSeek（必填，改成你自己的 key）----------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# ---------- Langfuse 连接（Node 应用读取）----------
# 本地自托管默认值，一般不用改。
# 只要和下面 headless 初始化里的 key 保持一致即可。
LANGFUSE_PUBLIC_KEY=pk-lf-1234567890
LANGFUSE_SECRET_KEY=sk-lf-1234567890
LANGFUSE_BASEURL=http://localhost:3000

# ---------- Langfuse headless 初始化（docker compose 读取）----------
# docker compose up 首次启动时，Langfuse 会自动创建好
# 组织 / 项目 / API key / 用户，免去 UI 里手动注册。
LANGFUSE_INIT_ORG_ID=local-org
LANGFUSE_INIT_ORG_NAME=Local Org
LANGFUSE_INIT_PROJECT_ID=local-project
LANGFUSE_INIT_PROJECT_NAME=Local Project
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-1234567890
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-1234567890
LANGFUSE_INIT_USER_EMAIL=dev@local.dev
LANGFUSE_INIT_USER_NAME=Dev
LANGFUSE_INIT_USER_PASSWORD=dev-password-123
